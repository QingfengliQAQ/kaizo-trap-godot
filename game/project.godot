; Engine configuration file.
; Kaizo Trap (孔明の罠) - Godot 4 Fan Recreation

config_version=5

[application]

config/name="Kaizo Trap"
config/description="Hardcore 2D Kaizo Platformer & Interactive Meta-ARG Recreation"
run/main_scene="res://scenes/core/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://autoload/GameState.gd"
SecretManager="*res://autoload/SecretManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
ReplayManager="*res://autoload/ReplayManager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

