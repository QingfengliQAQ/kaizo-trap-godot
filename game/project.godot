[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Hazards"
2d_physics/layer_4="KaizoHidden"
2d_physics/layer_5="Interactive"
2d_physics/layer_6="OneWay"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
2d/default_gravity=980.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.0509804, 0.0470588, 0.0784314, 1)
